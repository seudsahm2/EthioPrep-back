DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Local PostgreSQL (non-Docker) - preferred explicit fields
DB_NAME=ethioprep
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Optional URL style fallback (used only when DB_* values are not set)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ethioprep

# Local Redis (optional unless you run Celery/Redis-backed cache)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
DEFAULT_RATE_THROTTLE=120/min

SUPABASE_DB_URL=postgresql://postgres:postgres@your-supabase-host:5432/postgres
OPENAI_API_KEY=
AI_PROVIDER=mock

# Frontend + OAuth
FRONTEND_URL=http://localhost:5173
# If testing via ngrok frontend URL, set FRONTEND_URL to the https ngrok URL
# so OAuth callbacks redirect to the same public frontend host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINIAPP_AUTH_MAX_AGE_SECONDS=86400
REGISTRATION_CODE_EXPIRES_MINUTES=10
DEFAULT_FROM_EMAIL=no-reply@ethioprep.local

# Email/SMTP (production)
# Prefer a dedicated transactional sender. If using Google SMTP, set these values accordingly.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
SERVER_EMAIL=no-reply@ethioprep.local

MEDIA_ROOT=media
MEDIA_URL=/media/